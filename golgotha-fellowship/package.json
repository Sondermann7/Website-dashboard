{
  "name": "golgotha-fellowship-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Golgotha Fellowship (Nampa, Idaho) church website. Astro + TypeScript + Tailwind.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:review": "PUBLIC_REVIEW_MODE=true astro build",
    "build:preview": "PUBLIC_STANDINS=true astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "launch-check": "node scripts/launch-check.mjs",
    "audit": "node scripts/site-audit.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@lucide/astro": "^1.73.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.163.0"
  }
