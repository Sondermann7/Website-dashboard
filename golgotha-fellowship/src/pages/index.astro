---
import { getCollection } from 'astro:content';
import BookOpen from '@lucide/astro/icons/book-open';
import Heart from '@lucide/astro/icons/heart';
import Baby from '@lucide/astro/icons/baby';
import Play from '@lucide/astro/icons/play';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Users from '@lucide/astro/icons/users';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import ServiceBand from '../components/ServiceBand.astro';
import Photo from '../components/Photo.astro';
import MinistryCard from '../components/MinistryCard.astro';
import EventList from '../components/EventList.astro';
import RadioCard from '../components/RadioCard.astro';
import ConnectCta from '../components/ConnectCta.astro';
import ReviewFlag from '../components/ReviewFlag.astro';
import { church } from '../config/church';
import { getPhoto } from '../lib/photos';
import { getTeachings } from '../lib/teachings';
import { formatDate } from '../lib/format';

const hero = getPhoto('hero');
const pastorPhoto = getPhoto('pastor-marty');
const teachings = (await getTeachings()).slice(0, 3);
const [latest, ...more] = teachings;
const homeMinistries = (await getCollection('ministries'))
  .filter((m) => m.data.showOnHome && m.data.status !== 'todo')
  .sort((a, b) => a.data.order - b.data.order);

const expect = [
  { icon: BookOpen, title: 'The Bible, line by line', text: 'Our services are centered on Scripture. We teach through the Bible simply and systematically, so you hear the whole counsel of God’s Word.', href: '/teachings', link: 'Hear a teaching' },
  { icon: Heart, title: 'Come as you are', text: 'Services are casual. You do not need to dress up, know the songs, or have it all together. Following Jesus is a relationship grounded in His love and grace.', href: '/new-here', link: 'Plan your visit' },
  { icon: Baby, title: 'A place for your kids', text: 'Nursery and children’s ministry through sixth grade are available on Sundays, with children’s ministry on Wednesday evenings too. A greeter will help you check in.', href: '/ministries/kids', link: 'About kids ministry' },
];
---
<Base title={`${church.name} | Bible-Teaching Church in Nampa, Idaho`} description={`${church.shortDescription} Sundays at 8:30 and 10:30 AM, Wednesdays at 6:00 PM.`}>
  <!-- 1. Hero -->
  <section class="on-dark relative isolate overflow-hidden bg-ink text-cream">
    {hero && (
      <>
        <Photo name="hero" alt="" eager sizes="100vw" widths={[640, 1024, 1600, 2400]} class="absolute inset-0 -z-20 h-full w-full object-cover" />
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/90 via-ink/75 to-ink/45"></div>
      </>
    )}
    {!hero && <div class="absolute inset-y-0 right-0 -z-10 hidden w-[38%] bg-ink-soft lg:block" aria-hidden="true"></div>}
    <div class="container-site grid gap-10 py-20 md:py-28 lg:grid-cols-[1.6fr_1fr] lg:items-end lg:py-36">
      <div>
        <p class="eyebrow mb-5">{church.address.areaNote}, Idaho</p>
        <h1 class="max-w-[14ch] text-[length:var(--text-display)] leading-[1.04]">Come grow in God’s Word with us.</h1>
        <p class="mt-6 max-w-xl text-[length:var(--text-lede)] leading-relaxed text-mist">{church.shortDescription}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/new-here" variant="light" goal="plan-visit">Plan Your Visit</Button>
          <Button href="/teachings" variant="outline-light" goal="watch"><Play size={18} aria-hidden="true" /> Watch a Teaching</Button>
        </div>
      </div>
      {!hero && (
        <div class="hidden border-l-2 border-clay pl-7 lg:block">
          <p class="eyebrow">Hebrews 10:23–25 · Acts 2:42</p>
          <p class="mt-3 font-display text-[1.55rem] leading-snug text-cream">Holding fast to our hope, gathering together, and continuing in the apostles’ doctrine, fellowship, communion and prayer.</p>
        </div>
      )}
    </div>
    <ReviewFlag class="container-site mb-6 !w-auto">Hero photo: add a real, approved congregation photo as src/assets/photos/hero.jpg. Headline and supporting copy need pastoral approval.</ReviewFlag>
  </section>

  <!-- 2. Service times -->
  <ServiceBand />

  <!-- 3. What to expect -->
  <Section id="expect" eyebrow="Your first visit" title="What to expect at Golgotha Fellowship" intro="No pressure and no pretense — just people opening the Bible together.">
    <ul class="grid gap-5 md:grid-cols-3">
      {expect.map((c) => (
        <li class="card relative flex flex-col p-6 md:p-8">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-sage-muted text-sage"><c.icon size={26} aria-hidden="true" /></span>
          <h3 class="mt-5">{c.title}</h3>
          <p class="mt-3 text-body">{c.text}</p>
          <p class="mt-auto pt-5"><a class="card-link link inline-flex min-h-11 items-center gap-1.5 after:absolute after:inset-0 after:content-['']" href={c.href}>{c.link} <ArrowRight size={18} aria-hidden="true" /></a></p>
        </li>
      ))}
    </ul>
    <p class="mt-10"><Button href="/new-here" variant="secondary" goal="plan-visit">Everything you need for your first visit</Button></p>
  </Section>

  <!-- 4. Pastoral welcome -->
  <Section id="welcome" tone="sage">
    <div class:list={['grid gap-10 lg:items-center', pastorPhoto && 'lg:grid-cols-[0.8fr_1.2fr]']}>
      <Photo name="pastor-marty" alt={`${church.seniorPastor.name}, senior pastor of ${church.name}`} class="aspect-[4/5] w-full max-w-md rounded-[var(--radius-card)] object-cover" />
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">Welcome</p>
        <h2 id="welcome-heading">Meet {church.seniorPastor.known}</h2>
        <p class="mt-5 text-[length:var(--text-lede)] leading-relaxed">{church.seniorPastor.name} — {church.seniorPastor.known} to most of us — serves as senior pastor of {church.name}.</p>
        <p class="mt-4 text-body">We are a fellowship of ordinary people learning to follow Jesus together. We hold fast to God’s Word, we look for Christ’s return, and we would love for you to join us.</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href="/leadership" variant="secondary">Meet our leadership</Button>
          <Button href="/about" variant="secondary">About our church</Button>
        </div>
        <ReviewFlag class="mt-6">Replace with Pastor Marty’s own approved welcome message, and add an approved portrait as src/assets/photos/pastor-marty.jpg.</ReviewFlag>
      </div>
    </div>
  </Section>

  <!-- 5. Latest teaching -->
  <Section id="teaching" tone="white" eyebrow="Bible teaching" title={latest ? 'Latest teaching' : 'Watch and listen'} intro="Teachings are free to watch. No account or sign-in needed.">
    <div class="grid gap-6 lg:grid-cols-[1.5fr_1fr]">
      {latest ? (
        <article class="card relative overflow-hidden">
          {latest.thumbnail && <img src={latest.thumbnail} alt="" width="480" height="360" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />}
          <div class="p-6 md:p-8">
            <p class="text-[0.95rem] text-body">{formatDate(latest.date)}{latest.speaker && ` · ${latest.speaker}`}</p>
            <h3 class="mt-2 !text-[1.75rem]">
              <a class="card-link no-underline after:absolute after:inset-0 after:content-['']" href={latest.href ?? latest.videoUrl} data-goal="watch" {...(latest.href ? {} : { target: '_blank', rel: 'noopener' })}>{latest.title}{!latest.href && <span class="sr-only"> (opens in a new tab)</span>}</a>
            </h3>
            {latest.passage && <p class="mt-2 font-semibold text-sage">{latest.passage}</p>}
            <p class="mt-5 flex items-center gap-2 font-semibold text-sage" aria-hidden="true"><Play size={18} /> Watch now</p>
          </div>
        </article>
      ) : (
        <div class="on-dark flex flex-col justify-between rounded-[var(--radius-card)] bg-ink p-7 text-cream md:p-10">
          <div>
            <h3 class="!text-[1.9rem]">Teachings on YouTube</h3>
            <p class="mt-3 max-w-lg text-mist">Watch current and past teachings from {church.name} on our YouTube channel.</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href={church.youtube.channelUrl} variant="light" external goal="watch"><Play size={18} aria-hidden="true" /> Watch on YouTube</Button>
            <Button href="/teachings" variant="outline-light">All teachings</Button>
          </div>
          <ReviewFlag class="mt-6">Add the YouTube channel ID in src/config/church.ts and the newest teaching appears here automatically.</ReviewFlag>
        </div>
      )}
      <div class="grid content-start gap-5">
        {more.map((t) => (
          <a class="card block p-5 no-underline" href={t.href ?? t.videoUrl} {...(t.href ? {} : { target: '_blank', rel: 'noopener' })}>
            <span class="text-[0.9rem] text-body">{formatDate(t.date, { weekday: undefined })}</span>
            <span class="mt-1 block font-display text-[1.25rem] leading-snug">{t.title}</span>
          </a>
        ))}
        <RadioCard />
        {latest && <p><Button href="/teachings" variant="secondary">Browse all teachings</Button></p>}
      </div>
    </div>
  </Section>

  <!-- 6. Ministries -->
  <Section id="ministries" eyebrow="For every age" title="Find your place" intro="From the nursery to Bible studies, there is a place for you and your family.">
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {homeMinistries.map((m) => <li><MinistryCard ministry={m} /></li>)}
      <li>
        <article class="card relative flex h-full flex-col p-6 md:p-7">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-sage-muted text-sage"><Users size={26} aria-hidden="true" /></span>
          <h3 class="mt-4"><a class="card-link no-underline after:absolute after:inset-0 after:content-['']" href="/ministries">Community &amp; Bible studies</a></h3>
          <p class="mt-3 text-body">Men’s and women’s ministries, outreach, missions, and many ways to serve alongside others.</p>
          <p class="mt-auto flex items-center gap-1.5 pt-5 font-semibold text-sage" aria-hidden="true">See all ministries <ArrowRight size={18} /></p>
        </article>
      </li>
    </ul>
  </Section>

  <!-- 7. Beliefs + mission -->
  <Section id="beliefs" tone="ink">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow mb-3">What we believe</p>
        <h2 id="beliefs-heading">Anchored in Scripture, centered on Jesus Christ</h2>
      </div>
      <div>
        <p class="text-[length:var(--text-lede)] leading-relaxed text-mist">We believe the Bible is the inspired, authoritative Word of God, that salvation is by God’s grace through faith in Jesus Christ alone, and that He is coming again.</p>
        <p class="mt-4 text-mist">{church.affiliation.summary}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/beliefs" variant="light">Read what we believe</Button>
          <Button href="/about" variant="outline-light">Our mission</Button>
        </div>
      </div>
    </div>
  </Section>

  <!-- 8. Events -->
  <Section id="events" tone="white" eyebrow="Gather with us" title="Upcoming events">
    <EventList limit={3} />
    <p class="mt-8"><Button href="/events" variant="secondary">Weekly schedule &amp; events</Button></p>
  </Section>

  <!-- 9. Prayer + connect -->
  <ConnectCta />
</Base>
