---
import Phone from '@lucide/astro/icons/phone';
import Mail from '@lucide/astro/icons/mail';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import FormBlock from '../components/FormBlock.astro';
import { church, telHref, mailHref } from '../config/church';
---
<Base title="Prayer Request" description={`Send a private prayer request to ${church.name} in Nampa, Idaho. We would be honored to pray for you.`}>
  <PageHero photo="page-prayer" eyebrow="Prayer" title="How can we pray for you?" lede="Whatever you are facing, you do not have to carry it alone. Tell us, and we will pray." />
  <Section>
    <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr] lg:gap-16">
      <div class="card p-6 md:p-10">
        <FormBlock type="prayer" emailSubject="Prayer request" />
      </div>
      <aside aria-labelledby="talk-heading" class="flex flex-col gap-6 lg:sticky lg:top-28 lg:self-start">
        <div class="on-dark relative overflow-hidden rounded-[var(--radius-card)] bg-navy p-7 text-white shadow-[var(--shadow-lift)]">
          <h2 id="talk-heading" class="!text-[1.6rem] !font-bold">Would you rather talk?</h2>
          <p class="mt-3 text-mist">Call or email the church office. Someone will be glad to listen and pray with you.</p>
          <div class="mt-6 grid gap-3">
            <a class="btn btn-gold" href={telHref} data-goal="call"><Phone size={18} aria-hidden="true" /> {church.phone.display}</a>
            <a class="btn btn-outline-light" href={`${mailHref}?subject=${encodeURIComponent('Prayer request')}`} data-goal="email"><Mail size={18} aria-hidden="true" /> Email us</a>
          </div>
          <p class="mt-4 break-words text-[0.92rem] text-mist">{church.email.general}</p>
        </div>
        <p class="rounded-[var(--radius-card)] border border-error/30 bg-error-bg px-5 py-4 text-[0.98rem] text-error"><strong>In an emergency</strong>, if you or someone else is in danger, call 911.</p>
      </aside>
    </div>
  </Section>
</Base>
