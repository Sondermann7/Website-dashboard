---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import FormBlock from '../components/FormBlock.astro';
import { church } from '../config/church';
---
<Base title="Prayer Request" description={`Send a private prayer request to ${church.name} in Nampa, Idaho. We would be honored to pray for you.`}>
  <PageHero eyebrow="Prayer" title="How can we pray for you?" lede="Whatever you are facing, you do not have to carry it alone. Tell us, and we will pray." />
  <Section>
    <div class="max-w-3xl"><FormBlock type="prayer" emailSubject="Prayer request" /></div>
    <p class="mt-8 max-w-3xl text-body">If you or someone else is in immediate danger, call 911.</p>
  </Section>
</Base>
