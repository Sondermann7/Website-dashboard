---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ReviewFlag from '../components/ReviewFlag.astro';
import { church, telHref, mailHref } from '../config/church';

const entry = await getEntry('beliefs', 'statement');
if (!entry) throw new Error('src/content/beliefs/statement.md is missing');
const migrated = entry.data.approvalStatus !== 'pending';
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

/**
 * Topic inventory from the site audit (2026-11-16). This is NOT the Statement of Faith;
 * it is shown, clearly labeled, only until the official text is migrated verbatim.
 */
const topics = [
  { id: 'scripture', title: 'Scripture', text: 'Scripture is inspired, authoritative, infallible, and inerrant in its original writings.' },
  { id: 'trinity', title: 'The Trinity', text: 'There is one God: Father, Son, and Holy Spirit.' },
  { id: 'jesus-christ', title: 'Jesus Christ', text: 'We affirm Jesus’ deity, virgin birth, sinless life, miracles, atoning death, bodily resurrection, ascension, and future return.' },
  { id: 'salvation', title: 'Salvation', text: 'Jesus Christ is the only way of salvation; His death and resurrection are central to the gospel. Salvation is by God’s grace through faith, not earned by works.' },
  { id: 'holy-spirit', title: 'The Holy Spirit', text: 'The Holy Spirit indwells believers and empowers spiritual gifts.' },
  { id: 'return-of-christ', title: 'The Return of Christ', text: 'We hold to a pre-tribulational, premillennial rapture, the imminence of Christ’s return, and a literal millennial kingdom.' },
  { id: 'creation', title: 'Creation', text: 'We hold a literal interpretation of the Genesis creation account and a young-earth creation perspective.' },
  { id: 'marriage', title: 'Marriage', text: 'Marriage is a lifelong union between one genetic man and one genetic woman.' },
];
const nav = migrated ? toc.map((h) => ({ id: h.slug, title: h.text })) : topics;
---
<Base title="What We Believe" description={`What ${church.name} in Nampa, Idaho believes about Scripture, Jesus Christ, salvation, the Holy Spirit, and the return of Christ.`}>
  <PageHero eyebrow="What we believe" title={migrated ? entry.data.title : 'What we believe'} lede="Everything we teach comes from the Bible. Here is what we believe it says." />

  <Section id="statement">
    <div class="grid gap-10 lg:grid-cols-[16rem_1fr] lg:gap-16">
      {nav.length > 0 && (
        <nav aria-label="On this page" class="lg:sticky lg:top-28 lg:self-start">
          <h2 class="eyebrow plain !font-sans">On this page</h2>
          <ul class="mt-3 border-l-2 border-line">
            {nav.map((n) => <li><a class="-ml-0.5 flex min-h-11 items-center border-l-2 border-transparent pl-4 font-semibold text-navy underline-offset-4 hover:border-gold hover:underline" href={`#${n.id}`}>{n.title}</a></li>)}
          </ul>
        </nav>
      )}
      <div>
        {migrated ? (
          <>
            <article class="prose"><Content /></article>
            {entry.data.approvalStatus === 'migrated' && <ReviewFlag class="mt-8">Statement text migrated. Awaiting pastoral approval — set approvalStatus to “approved” in src/content/beliefs/statement.md.</ReviewFlag>}
          </>
        ) : (
          <>
            <p class="max-w-[var(--container-prose)] rounded-lg border border-line bg-white p-5 text-body">
              <strong class="text-navy">This page is a summary.</strong> It outlines the main points of our Statement of Faith. For the full statement with Scripture references, please <a class="link" href={mailHref}>email</a> or <a class="link" href={telHref}>call</a> the church office.
            </p>
            <ReviewFlag class="mt-4 max-w-[var(--container-prose)]">
              LAUNCH BLOCKER. The official Statement of Faith could not be read during the build (the old site was unreachable from the build environment), so it has NOT been migrated. Paste the full text, word for word, into src/content/beliefs/statement.md from {church.legacyUrls.beliefs}. This summary then disappears automatically. Until then it must be read and approved by the pastor like any other religious copy.
            </ReviewFlag>
            <div class="mt-10 max-w-[var(--container-prose)] divide-y divide-line border-y border-line">
              {topics.map((t) => (
                <section id={t.id} aria-labelledby={`${t.id}-h`} class="py-7">
                  <h2 id={`${t.id}-h`} class="!text-[length:var(--text-h3)]">{t.title}</h2>
                  <p class="mt-2 text-[1.08rem]">{t.text}</p>
                </section>
              ))}
            </div>
          </>
        )}
        <div class="mt-12 max-w-[var(--container-prose)] rounded-[var(--radius-card)] bg-stone p-6 md:p-8">
          <h2 class="!text-[length:var(--text-h3)]">Questions about what we believe?</h2>
          <p class="mt-2 text-body">We are always glad to open the Bible with you. Come on a Sunday, or get in touch.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <Button href="/contact">Ask a question</Button>
            <Button href="/teachings" variant="secondary">Hear a teaching</Button>
          </div>
        </div>
      </div>
    </div>
  </Section>
</Base>
