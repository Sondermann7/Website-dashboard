---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Photo from '../components/Photo.astro';
import ConnectCta from '../components/ConnectCta.astro';
import ReviewFlag from '../components/ReviewFlag.astro';
import { church } from '../config/church';

const leaders = (await getCollection('leadership')).filter((l) => l.data.status !== 'todo').sort((a, b) => a.data.order - b.data.order);
const groups = [
  { key: 'pastors', title: 'Pastors' },
  { key: 'elders', title: 'Elders' },
  { key: 'ministry-leaders', title: 'Ministry leaders' },
] as const;
const people = {
  '@context': 'https://schema.org',
  '@graph': leaders.map((l) => ({ '@type': 'Person', name: l.data.name, jobTitle: l.data.role, worksFor: { '@id': `${church.siteUrl}/#church` } })),
};
---
<Base title="Leadership" description={`Meet the pastors, elders and ministry leaders of ${church.name} in Nampa, Idaho, including senior pastor ${church.seniorPastor.name}.`}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(people)} />
  <PageHero eyebrow="Leadership" title="The people who serve this fellowship" lede="Our pastors, elders and ministry leaders are here to teach God’s Word and care for His people." />
  <Section id="leaders">
    <ReviewFlag class="mb-8 max-w-3xl">Names and roles are from the current leadership page, where wording varied between revisions. Confirm every name, spelling and title. Bios and portraits are intentionally left out until approved versions are supplied (src/content/leadership/leaders.yaml).</ReviewFlag>
    <div class="space-y-14">
      {groups.map((g) => {
        const list = leaders.filter((l) => l.data.group === g.key);
        return list.length > 0 && (
          <section aria-labelledby={`${g.key}-h`}>
            <h2 id={`${g.key}-h`} class="mb-6 border-b border-line pb-3">{g.title}</h2>
            <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {list.map((l) => (
                <li class="card flex h-full flex-col overflow-hidden" id={l.id}>
                  <Photo name={l.data.photo ? `leadership/${l.data.photo}` : undefined} alt={`${l.data.name}, ${l.data.role}`} class="aspect-[4/5] w-full object-cover" sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw" />
                  <div class="p-6">
                    <h3>{l.data.name}</h3>
                    {l.data.known && <p class="text-[0.95rem] text-body">“{l.data.known}”</p>}
                    <p class="mt-1.5 font-semibold text-blue">{l.data.role}</p>
                    {l.data.bio && <p class="mt-3 text-body">{l.data.bio}</p>}
                    {l.data.reviewNote && <ReviewFlag class="mt-3">{l.data.reviewNote}</ReviewFlag>}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  </Section>
  <ConnectCta />
</Base>
