---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import { church } from '../../config/church';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const entries = (await getCollection('teachings')).filter((t) => t.data.published);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const t = entry.data;
const { Content } = await render(entry);
const meta = [formatDate(t.date), t.speaker, t.passage, t.series && `Series: ${t.series}`].filter(Boolean).join(' · ');
---
<Base title={t.title} description={t.summary ?? `${t.title}${t.passage ? ` (${t.passage})` : ''} — a Bible teaching from ${church.name}, Nampa, Idaho.`}>
  <PageHero eyebrow="Teaching" title={t.title} lede={meta}>
    {t.videoUrl && <Button href={t.videoUrl} external goal="watch">Watch</Button>}
    {t.audioUrl && <Button href={t.audioUrl} variant="secondary" external>Listen</Button>}
    {t.notesUrl && <Button href={t.notesUrl} variant="secondary" external>Notes</Button>}
    {t.transcriptUrl && <Button href={t.transcriptUrl} variant="secondary" external>Transcript</Button>}
  </PageHero>
  <Section>
    <article class="prose">
      {t.summary && <p class="text-[length:var(--text-lede)]">{t.summary}</p>}
      <Content />
    </article>
    <p class="mt-10"><Button href="/teachings" variant="secondary">← All teachings</Button></p>
  </Section>
</Base>
