---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ReviewFlag from '../components/ReviewFlag.astro';
import HoldFastPlayer from '../components/HoldFastPlayer.astro';
import StationCard from '../components/StationCard.astro';
import Radio from '@lucide/astro/icons/radio';
import { church } from '../config/church';
const radio = church.radio;
---
<Base title="Hold Fast & 97.5 FM" description={`Listen to Hold Fast with ${church.seniorPastor.known}: verse-by-verse Bible teaching from ${church.name} in Nampa, Idaho. Play recent episodes here, or listen live on 97.5 FM.`}>
  <PageHero photo="pastor-teaching" eyebrow="Listen" title="Hold Fast, every weekday" lede={`${church.seniorPastor.known} teaching through the Bible verse by verse, chapter by chapter, and book by book. Play it here, on the radio, or in your podcast app.`} />

  <Section>
    <h2 class="sr-only">Play Hold Fast</h2>
    <div class="grid gap-8 lg:grid-cols-[1.25fr_1fr] lg:items-start">
      <HoldFastPlayer heading="Hold Fast" />
      <div class="card p-6 md:p-8">
        <p class="eyebrow plain flex items-center gap-2"><Radio size={18} aria-hidden="true" /> On the air</p>
        <h2 class="mt-1 !text-[length:var(--text-h3)]">Hold Fast on the radio</h2>
        <dl class="mt-4 divide-y divide-line border-y border-line">
          {radio.broadcasts.map((b) => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
              <dt class="font-semibold">{b.station}</dt>
              <dd class="text-body">{b.when}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-5 flex flex-wrap gap-3">
          <Button href={church.podcast.appleUrl} variant="secondary" external>Apple Podcasts</Button>
          <Button href={church.youtube.channelUrl} variant="secondary" external goal="watch">YouTube</Button>
        </p>
        {radio.status === 'confirm' && <ReviewFlag class="mt-5">Confirm current Hold Fast stations and air times. A search also lists Hold Fast on 94.1 The Voice.</ReviewFlag>}
      </div>
    </div>
  </Section>

  <Section tone="stone" id="station" title="Listen live on the radio">
    <StationCard class="max-w-3xl" />
  </Section>
</Base>
