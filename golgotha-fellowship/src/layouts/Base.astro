---
import '../styles/global.css';
import serifFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Schema from '../components/Schema.astro';
import Announcements from '../components/Announcements.astro';
import { church } from '../config/church';
import { REVIEW, PREVIEW } from '../lib/review';
import { cleanPath } from '../lib/format';

interface Props {
  title: string;
  description: string;
  /** Set true for utility pages that should not be indexed. */
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, noindex = false, ogImage = '/og-default.png' } = Astro.props;
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site).href;
const fullTitle = title.includes(church.name) ? title : `${title} | ${church.name}`;
const og = new URL(ogImage, Astro.site).href;
const ga4 = import.meta.env.PUBLIC_GA4_ID;
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || REVIEW) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/brand/golgotha-logo-navy.svg" as="image" type="image/svg+xml" />
    <meta name="theme-color" content="#313D65" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={church.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="geo.region" content="US-ID" />
    <meta name="geo.placename" content="Nampa" />
    {gsc && <meta name="google-site-verification" content={gsc} />}
    <Schema />
    <slot name="head" />
    {PREVIEW && (
      <script is:inline>
        // Preview only: the artifact viewer carries the previous page's scroll position over to the
        // next page. Open each newly visited page at the top; Back and Forward keep their position.
        (function () {
          var nav = (performance.getEntriesByType && performance.getEntriesByType('navigation')[0]) || {};
          if (nav.type === 'back_forward' || location.hash) return;
          try { history.scrollRestoration = 'manual'; } catch (e) {}
          var top = function () { window.scrollTo(0, 0); };
          top();
          document.addEventListener('DOMContentLoaded', top);
          window.addEventListener('load', function () { top(); setTimeout(top, 60); setTimeout(top, 250); });
        })();
      </script>
    )}
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50">Skip to main content</a>
    {REVIEW && (
      <aside aria-label="Review build notice" class="review-flag !rounded-none !border-x-0 !border-t-0 text-center">
        <strong>REVIEW BUILD</strong> — dashed orange boxes mark items the church must verify. They never appear on the public site.
      </aside>
    )}
    <Announcements />
    <Header />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <div class="progress" aria-hidden="true"></div>
    <script is:inline>
      // Motion. Does nothing (and hides nothing) without IntersectionObserver or with "reduce motion" on.
      (function () {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var root = document.documentElement;
        root.classList.add('mo');
        var sel = 'main :is(h2, .eyebrow, .lede, .card, .tile, [data-reveal], .prose > *, dl > div, .review-flag)';
        var els = [].filter.call(document.querySelectorAll(sel), function (el) {
          return !el.closest('.hero, form, dialog, [data-no-mo]') && !(el.parentElement && el.parentElement.closest('[data-mo]'));
        });
        els.forEach(function (el) {
          if (el.closest('[data-mo]')) return;
          var i = [].indexOf.call(el.parentElement.children, el);
          el.setAttribute('data-mo', '');
          if (el.matches('.card, .tile, li > *, dl > div') || el.parentElement.matches('li')) {
            var row = el.parentElement.matches('li') ? [].indexOf.call(el.parentElement.parentElement.children, el.parentElement) : i;
            el.style.setProperty('--mo-d', Math.min(row * 50, 250) + 'ms');
          }
        });
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
        document.querySelectorAll('[data-mo]').forEach(function (el) { io.observe(el); });
        var bar = document.querySelector('.progress'), kin = document.querySelectorAll('[data-kinetic]'), tick = false;
        function frame() {
          tick = false;
          var max = root.scrollHeight - innerHeight;
          root.classList.toggle('scrolled', scrollY > 8);
          if (bar) bar.style.setProperty('--p', max > 0 ? (scrollY / max).toFixed(4) : 0);
          kin.forEach(function (k) {
            var r = k.getBoundingClientRect();
            var t = 1 - Math.min(1, Math.max(0, (r.top + r.height * 0.5) / innerHeight));
            k.style.setProperty('--k', Math.min(1, Math.max(0, t * 1.6)).toFixed(3));
          });
        }
        addEventListener('scroll', function () { if (!tick) { tick = true; requestAnimationFrame(frame); } }, { passive: true });
        frame();
      })();
    </script>

    {ga4 && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
        <script is:inline define:vars={{ ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga4, { anonymize_ip: true });
          // Visitor goals only (directions, call, watch, plan-visit, give). Never form contents.
          document.addEventListener('click', function (e) {
            var el = e.target && e.target.closest ? e.target.closest('[data-goal]') : null;
            if (el) gtag('event', 'goal_click', { goal: el.getAttribute('data-goal'), page: location.pathname });
          });
        </script>
      </>
    )}
    {cfBeacon && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeacon })}></script>}
  </body>
</html>
