---
/** Service times + address + one-tap directions / call. Reads only from the church config. */
import MapPin from '@lucide/astro/icons/map-pin';
import Clock from '@lucide/astro/icons/clock';
import Phone from '@lucide/astro/icons/phone';
import { church, primaryGatherings, addressOneLine, directionsUrl, telHref } from '../config/church';
import { joinTimes } from '../lib/format';
---
<section aria-labelledby="service-times-heading" class="border-b border-line bg-white">
  <div class="container-site grid gap-8 py-10 md:grid-cols-[1.25fr_1fr] md:gap-12 md:py-12">
    <div>
      <h2 id="service-times-heading" class="eyebrow plain mb-5 flex items-center gap-2 !font-sans"><Clock size={18} aria-hidden="true" /> Service times</h2>
      <dl class="grid gap-6 sm:grid-cols-2">
        {primaryGatherings.map((g) => (
          <div>
            <dt class="font-semibold text-body">{g.day}s</dt>
            <dd class="mt-1 font-display text-[1.6rem] leading-tight lg:whitespace-nowrap xl:text-[1.85rem]">{joinTimes(g.times)}</dd>
            {g.note && <dd class="mt-2 text-[0.95rem] text-body">{g.note}</dd>}
          </div>
        ))}
      </dl>
    </div>
    <div class="md:border-l md:border-line md:pl-12">
      <h2 class="eyebrow plain mb-5 flex items-center gap-2 !font-sans"><MapPin size={18} aria-hidden="true" /> Find us</h2>
      <address class="text-[1.15rem] not-italic leading-snug">
        {church.address.street}<br />
        {church.address.city}, {church.address.regionName} {church.address.postalCode}
        <span class="mt-1 block text-[0.95rem] text-body">{church.address.areaNote}</span>
      </address>
      <div class="mt-5 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={directionsUrl} target="_blank" rel="noopener" data-goal="directions" aria-label={`Get directions to ${addressOneLine} (opens in a new tab)`}>
          <MapPin size={18} aria-hidden="true" /> Get directions
        </a>
        <a class="btn btn-secondary" href={telHref} data-goal="call" aria-label={`Call ${church.phone.display}`}>
          <Phone size={18} aria-hidden="true" /> {church.phone.display}
        </a>
      </div>
    </div>
  </div>
</section>
