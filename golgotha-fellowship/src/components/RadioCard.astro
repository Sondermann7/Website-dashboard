---
import Radio from '@lucide/astro/icons/radio';
import { church } from '../config/church';
import ReviewFlag from './ReviewFlag.astro';
const r = church.radio;
---
{r.status !== 'todo' && (
  <div class="card p-6 md:p-7">
    <p class="eyebrow plain flex items-center gap-2"><Radio size={18} aria-hidden="true" /> On the radio</p>
    <h3 class="mt-2">{r.name}</h3>
    <p class="mt-2 text-body">Listen to Bible teaching from Golgotha Fellowship on weekday radio.</p>
    <dl class="mt-4 space-y-3">
      {r.broadcasts.map((b) => (
        <div><dt class="font-semibold">{b.station}</dt><dd class="text-body">{b.when}</dd></div>
      ))}
    </dl>
    {r.status === 'confirm' && <ReviewFlag class="mt-4">Confirm current Hold Fast stations and air times.</ReviewFlag>}
  </div>
)}
