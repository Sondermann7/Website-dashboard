---
import Baby from '@lucide/astro/icons/baby';
import Users from '@lucide/astro/icons/users';
import BookOpen from '@lucide/astro/icons/book-open';
import Heart from '@lucide/astro/icons/heart';
import Globe from '@lucide/astro/icons/globe';
import HandHeart from '@lucide/astro/icons/hand-heart';
import Flame from '@lucide/astro/icons/flame';
interface Props { name: string; size?: number }
const { name, size = 26 } = Astro.props;
const map: Record<string, any> = { baby: Baby, users: Users, 'book-open': BookOpen, heart: Heart, globe: Globe, 'hand-heart': HandHeart, flame: Flame };
const Icon = map[name] ?? Users;
---
<span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-sky text-blue"><Icon size={size} aria-hidden="true" /></span>
