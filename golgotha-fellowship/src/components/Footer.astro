---
import Logo from './Logo.astro';
import Dove from './Dove.astro';
import Motif from './Motif.astro';
import { church, footerNav, primaryGatherings, addressOneLine, directionsUrl, telHref, mailHref } from '../config/church';
import { joinTimes } from '../lib/format';
const year = new Date().getFullYear();
const social = [
  { label: 'YouTube', href: church.social.youtube, goal: 'watch' },
  { label: 'Facebook', href: church.social.facebook },
  { label: 'Instagram', href: church.social.instagram },
];
const fl = 'inline-flex min-h-11 min-w-11 items-center text-paper underline decoration-mist/40 underline-offset-4 hover:decoration-paper';
---
<footer class="relative bg-navy-deep pb-24 text-paper on-dark md:pb-0">
  <div class="container-site grid gap-12 py-14 md:py-20 lg:grid-cols-[1.35fr_2fr]">
    <div>
      <Logo tone="light" />
      <div class="mt-6 flex max-w-md items-start gap-4"><Dove tone="light" class="h-14 w-auto shrink-0" /><p class="text-[0.95rem] text-mist">{church.affiliation.summary}</p></div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
        <div>
          <h2 class="eyebrow plain !font-sans">Service times</h2>
          <ul class="mt-3 space-y-1">
            {primaryGatherings.map((g) => <li><span class="font-semibold">{g.day}s</span> <span class="text-mist">· {joinTimes(g.times)}</span></li>)}
          </ul>
        </div>
        <div>
          <h2 class="eyebrow plain !font-sans">Visit &amp; contact</h2>
          <address class="mt-3 not-italic">
            <a class={fl} href={directionsUrl} target="_blank" rel="noopener" data-goal="directions">{church.address.street}<br />{church.address.city}, {church.address.region} {church.address.postalCode}<span class="sr-only"> — get directions (opens in a new tab)</span></a><br />
            <a class={fl} href={telHref} data-goal="call">{church.phone.display}</a><br />
            <a class:list={[fl, 'break-words']} href={mailHref}>{church.email.general}</a>
          </address>
        </div>
      </div>
    </div>
    <nav aria-label="Footer" class="grid gap-10 sm:grid-cols-3">
      {footerNav.map((col) => (
        <div>
          <h2 class="eyebrow plain !font-sans">{col.heading}</h2>
          <ul class="mt-3">
            {col.links.map((l) => <li><a class={fl} href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="border-t border-paper/15">
    <div class="container-site flex flex-col gap-3 py-6 text-[0.9rem] text-mist md:flex-row md:items-center md:justify-between">
      <p class="flex items-center gap-3"><Motif kind="fish" stroke={2} class="h-4 w-8 shrink-0 text-gold-light/70" /><span>© {year} {church.name} · {addressOneLine}</span></p>
      <ul class="flex flex-wrap gap-x-6">
        {social.map((s) => (
          <li><a class={fl} href={s.href} target="_blank" rel="noopener me" data-goal={s.goal}>{s.label}<span class="sr-only"> (opens in a new tab)</span></a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
