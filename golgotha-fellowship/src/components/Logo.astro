---
/**
 * Golgotha Fellowship logo as a vector (traced from the church's own artwork), so it is
 * sharp at every size and screen density. Navy for light backgrounds, white for navy.
 * Files: public/brand/golgotha-logo-{navy,white}.svg (master: src/assets/brand/golgotha-logo.svg).
 * Replace them with the church's original vector logo when it is supplied.
 */
import { church } from '../config/church';
interface Props { tone?: 'dark' | 'light' }
const { tone = 'dark' } = Astro.props;
const file = tone === 'light' ? '/brand/golgotha-logo-white.svg' : '/brand/golgotha-logo-navy.svg';
---
<a href="/" class="inline-flex min-h-11 items-center no-underline">
  <img src={file} alt={`${church.name} — home`} width="4068" height="1316" class="h-12 w-auto md:h-[4.25rem]" loading={tone === 'light' ? 'lazy' : 'eager'} decoding="async" />
</a>
