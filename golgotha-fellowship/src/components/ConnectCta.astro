---
import { church, telHref } from '../config/church';
import Button from './Button.astro';
import Motif from './Motif.astro';
import Curve from './Curve.astro';
---
<section aria-labelledby="connect-heading" class="relative bg-stone pt-10 pb-24 md:pt-14 md:pb-32">
  <div class="container-site">
  <div class="relative isolate grid gap-8 overflow-hidden rounded-[var(--radius-panel)] bg-white p-7 shadow-[var(--shadow-lift)] ring-1 ring-navy/5 md:p-12 lg:grid-cols-[1.2fr_1fr] lg:items-center">
    <Motif kind="fish" stroke={1.1} class="pointer-events-none absolute -right-10 -top-6 -z-10 w-72 text-navy/[0.05]" />
    <div>
      <p class="eyebrow mb-3">We are here for you</p>
      <h2 id="connect-heading">Have a question, or <em>need prayer?</em></h2>
      <p class="mt-4 max-w-xl text-[length:var(--text-lede)] text-body">Whether you are planning a first visit or carrying something heavy, you do not have to do it alone. Reach out — we would be glad to hear from you.</p>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:ml-auto lg:w-full lg:max-w-md">
      <Button href="/prayer">Request prayer</Button>
      <Button href="/contact" variant="secondary">Contact us</Button>
      <Button href={telHref} variant="secondary" goal="call" class="sm:col-span-2">Call {church.phone.display}</Button>
    </div>
  </div>
  </div>
  <Curve fill="navy-deep" />
</section>
