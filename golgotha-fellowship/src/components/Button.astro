---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'light' | 'outline-light';
  goal?: string;
  external?: boolean;
  class?: string;
}
const { href, variant = 'primary', goal, external = false, class: cls = '' } = Astro.props;
---
<a
  href={href}
  class:list={['btn', `btn-${variant}`, cls]}
  data-goal={goal}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
>
  <slot />{external && <span class="sr-only"> (opens in a new tab)</span>}
</a>
