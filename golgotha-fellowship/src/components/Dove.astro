---
/**
 * Calvary Chapel dove (affiliation mark), a vector traced from the church's own graphic:
 * a solid disc with the dove cut out. Never redrawn. Files: public/brand/calvary-dove-{navy,white}.svg.
 * Replace with the official file when supplied.
 */
interface Props { tone?: 'dark' | 'light'; class?: string }
const { tone = 'dark', class: cls = 'h-16 w-auto' } = Astro.props;
const file = tone === 'light' ? '/brand/calvary-dove-white.svg' : '/brand/calvary-dove-navy.svg';
---
<img src={file} alt="Calvary Chapel" width="1608" height="1614" class:list={['shrink-0', cls]} loading="lazy" decoding="async" />
