---
/**
 * Renders an approved photo when the file exists in src/assets/photos/.
 * Missing photo: the review build shows a labeled stand-in so the layout can be judged;
 * the public build renders the fallback slot (or nothing). Never stock or generated imagery.
 */
import { Image } from 'astro:assets';
import { getPhoto } from '../lib/photos';
import { REVIEW } from '../lib/review';
interface Props { name?: string; alt: string; class?: string; widths?: number[]; sizes?: string; eager?: boolean; want?: string }
const { name, alt, class: cls = '', widths = [480, 800, 1200, 1600], sizes = '(min-width: 64rem) 50vw, 100vw', eager = false, want } = Astro.props;
const photo = getPhoto(name);
---
{photo ? (
  <Image src={photo} alt={alt} widths={widths} sizes={sizes} class={cls} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
) : REVIEW && name ? (
  <div class:list={['ph', cls]} data-review-flag>
    <strong>Photo needed</strong>
    <span>{want ?? alt}</span>
    <code>src/assets/photos/{name}.jpg</code>
  </div>
) : (
  <slot />
)}
