# ---- Build-time (public) -------------------------------------------------
# Show TODO_VERIFY review flags on the staged preview. NEVER set in production.
PUBLIC_REVIEW_MODE=false
# Turn the on-site forms on only after the church has confirmed the recipients below.
PUBLIC_FORMS_ENABLED=false
# Turn on just the prayer form (needs RESEND_API_KEY, FORMS_FROM and PRAYER_TO or CONTACT_TO).
PUBLIC_PRAYER_FORM=false
# Cloudflare Turnstile site key (spam protection). Optional but recommended.
PUBLIC_TURNSTILE_SITE_KEY=
# Analytics (all optional; nothing loads when blank).
PUBLIC_GA4_ID=
PUBLIC_CF_BEACON_TOKEN=
PUBLIC_GSC_VERIFICATION=

# ---- Cloudflare Pages Function secrets (set in the Pages dashboard) ------
# Email delivery for forms, via Resend (https://resend.com). Church-controlled account.
RESEND_API_KEY=
FORMS_FROM=website@golgothafellowship.org
CONTACT_TO=
PRAYER_TO=
INVOLVED_TO=
# Greeting team for "Let us know you are coming" (falls back to CONTACT_TO)
VISIT_TO=
TURNSTILE_SECRET_KEY=
